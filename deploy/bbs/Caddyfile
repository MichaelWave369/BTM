# Dedicated WSS gateway. Caddy handles ACME/TLS and WebSocket upgrades.
# Expose only /ws and a read-only /status endpoint to the public internet.
{$BBS_HOST} {
  @websocket path /ws
  reverse_proxy @websocket btm:8787
  @status path /status
  reverse_proxy @status btm:8787
  respond "Not found" 404
}
